---
import { MessageCircle } from '@lucide/astro';
import { SUPPORT_URL } from '../nav';

interface Props {
	/** `ink` for the header, `brand` for the full-width button in the mobile menu. */
	variant?: 'ink' | 'brand';
}

const { variant = 'ink' } = Astro.props;
---

<a href={SUPPORT_URL} class:list={['support', variant]} target="_blank" rel="noopener">
	<MessageCircle aria-hidden="true" />
	{Astro.locals.t('nav.support')}
</a>

<style>
	.support {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		height: 2.25rem;
		padding-inline: 0.75rem 0.875rem;
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 0.15s, translate 0.1s;
	}

	.support:active {
		translate: 0 1px;
	}

	.support :global(svg) {
		width: 1rem;
		height: 1rem;
	}

	.ink {
		background-color: var(--td-ink);
		color: var(--td-background);
	}

	.ink:hover {
		background-color: color-mix(in oklch, var(--td-ink) 80%, var(--td-background));
	}

	.brand {
		width: 100%;
		height: 3rem;
		font-size: var(--sl-text-base);
		font-weight: 600;
		background-color: var(--td-brand);
		color: var(--td-brand-foreground);
		box-shadow: 0 1px 2px 0 color-mix(in oklch, var(--td-brand) 20%, transparent);
	}

	.brand:hover {
		background-color: color-mix(in oklch, var(--td-brand) 90%, var(--td-background));
	}
</style>
