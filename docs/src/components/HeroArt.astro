---
/*
 * Notion-style hero scene, built like the exds.tg hero illustration:
 * a soft blob, hand-drawn doodles, dotted connectors and character stickers
 * (DiceBear "Notionists" by Zoish, CC0 1.0) around the fox-mask mark.
 */
import mark from '../assets/brand/mark.svg?url';
import caller from '../assets/stickers/caller.svg?url';
import pointer from '../assets/stickers/pointer.svg?url';
import waver from '../assets/stickers/waver.svg?url';

const stickers = [
	{ src: waver, bg: 'var(--td-sticker-yellow)', style: 'left: 1%; bottom: 3%; width: 30%' },
	{ src: pointer, bg: 'var(--td-sticker-blue)', style: 'right: 1%; top: 40%; width: 25%' },
	{ src: caller, bg: 'var(--td-sticker-green)', style: 'right: 12%; top: 1%; width: 20%' },
];

const ink = 'var(--td-ink)';
const brand = 'var(--td-brand)';
const stroke = {
	stroke: ink,
	'stroke-width': 3,
	'stroke-linecap': 'round',
	'stroke-linejoin': 'round',
	fill: 'none',
} as const;

const place = (x: number, y: number, s = 1, r = 0) => `translate(${x} ${y}) rotate(${r}) scale(${s})`;

/** Sketchy double stroke: a crisp outline plus a faint offset pass. */
const sketch = (d: string, fill = 'var(--td-card)') => [
	{ d, fill },
	{ d, ...stroke, 'stroke-width': 1.4, opacity: 0.35, transform: 'translate(2.5 3)' },
	{ d, ...stroke },
];

const sparkle = 'M0 -13 C2 -3 3 -2 13 0 C3 2 2 3 0 13 C-2 3 -3 2 -13 0 C-3 -2 -2 -3 0 -13 Z';
const terminal = sketch(
	'M-50 -36 H50 A8 8 0 0 1 58 -28 V28 A8 8 0 0 1 50 36 H-50 A8 8 0 0 1 -58 28 V-28 A8 8 0 0 1 -50 -36 Z',
	'var(--td-pastel-green)'
);
const bolt = sketch('M10 -42 L-22 6 L0 6 L-10 42 L24 -8 L2 -8 Z', 'var(--td-pastel-yellow)');
const book = sketch(
	'M0 -26 C-14 -36 -34 -36 -48 -30 V30 C-34 24 -14 24 0 34 C14 24 34 24 48 30 V-30 C34 -36 14 -36 0 -26 Z',
	'var(--td-pastel-purple)'
);
---

<div class="scene" aria-hidden="true">
	<svg viewBox="0 0 600 500">
		<path
			d="M300 40 C420 30 560 90 570 220 C580 350 480 470 330 470 C180 470 40 420 35 280 C30 150 170 50 300 40 Z"
			fill="var(--td-brand-soft)"
		/>
		<path d="M160 370 C200 320 220 305 235 300" {...stroke} stroke-width="2.5" stroke-dasharray="1 9" />
		<path d="M440 270 C420 262 405 256 390 252" {...stroke} stroke-width="2.5" stroke-dasharray="1 9" />
		<path d="M420 120 C405 140 395 150 380 160" {...stroke} stroke-width="2.5" stroke-dasharray="1 9" />

		<g transform={place(120, 125, 0.95, -6)}>
			{terminal.map((p) => <path {...p} />)}
			<path d="M-58 -18 H58" {...stroke} stroke-width="2.5" />
			<circle cx="-44" cy="-27" r="3.5" fill={ink} />
			<circle cx="-33" cy="-27" r="3.5" fill={ink} />
			<circle cx="-22" cy="-27" r="3.5" fill={brand} />
			<path d="M-36 -2 L-22 9 L-36 20" stroke={brand} stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
			<path d="M-12 20 H14" {...stroke} stroke-width="4" />
		</g>

		<g transform={place(245, 70, 0.8, 12)}>
			{bolt.map((p) => <path {...p} />)}
		</g>

		<g transform={place(470, 415, 0.75, 8)}>
			{book.map((p) => <path {...p} />)}
			<path d="M0 -26 V34" {...stroke} stroke-width="2.5" />
			<path d="M-36 -12 H-12 M-36 2 H-14 M12 -12 H36 M12 2 H30" {...stroke} stroke-width="2.5" />
		</g>

		<path transform={place(540, 330, 1.3)} d={sparkle} fill={brand} />
		<path transform={place(60, 260, 0.9)} d={sparkle} fill={ink} />
		<path transform={place(395, 55, 0.8)} d={sparkle} fill={ink} />
	</svg>

	<img class="mark" src={mark} alt="" draggable="false" />

	{
		stickers.map(({ src, bg, style }) => (
			<div class="sticker" style={`${style}; background-color: ${bg}`}>
				<img src={src} alt="" draggable="false" />
			</div>
		))
	}
</div>

<style>
	.scene {
		position: relative;
		width: 100%;
		aspect-ratio: 6 / 5;
		user-select: none;
	}

	svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.mark {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 32%;
		aspect-ratio: 1;
		translate: -50% -50%;
		rotate: -4deg;
		border: 3px solid var(--td-ink);
		border-radius: 22%;
		box-shadow: 4px 6px 0 0 var(--td-shadow-hard);
	}

	/* a Notion-style "face sticker": character in an outlined pastel circle */
	.sticker {
		position: absolute;
		aspect-ratio: 1;
		overflow: hidden;
		border: 2.5px solid var(--td-ink);
		border-radius: 999px;
		box-shadow: 3px 4px 0 0 var(--td-shadow-hard);
	}

	.sticker img {
		width: 100%;
		height: 100%;
		translate: 0 7%;
		scale: 1.1;
	}
</style>
