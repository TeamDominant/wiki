---
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import LanguageSelect from './LanguageSelect.astro';
import SiteTitle from './SiteTitle.astro';
import SupportButton from './SupportButton.astro';
import ThemeSelect from './ThemeSelect.astro';
import { NAV_LINKS, localizedPath } from '../nav';

const { locale } = Astro.locals.starlightRoute;
// Wiki / Docs: each topic has its own sidebar, the current one is highlighted.
const topics = Astro.locals.starlightSidebarTopics?.topics ?? [];
const links = NAV_LINKS.map(({ label, path }) => {
	const href = localizedPath(path, locale);
	return { href, label: Astro.locals.t(label), current: Astro.url.pathname.startsWith(href) };
});
---

<div class="header">
	<div class="title-wrapper">
		<SiteTitle />
		<nav class="nav-links" aria-label="TeamDominant">
			<div class="topics">
				{
					topics.map(({ link, label, isCurrent }) => (
						<a href={link} aria-current={isCurrent ? 'true' : undefined}>
							{label}
						</a>
					))
				}
			</div>
			{
				links.map(({ href, label, current }) => (
					<a class="extra" href={href} aria-current={current ? 'page' : undefined}>
						{label}
					</a>
				))
			}
		</nav>
	</div>
	<div class="sl-flex print:hidden">
		<Search />
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<ThemeSelect />
		<LanguageSelect />
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<div class="support">
			<SupportButton />
		</div>
	</div>
</div>

<style>
	/* Layout mirrors Starlight’s own <Header>, plus the nav links next to the title. */
	.header {
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.title-wrapper {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
		overflow: clip;
		/* Avoid clipping the focus ring and the logo shadow. */
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	.nav-links {
		display: none;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-links a {
		border-radius: 999px;
		padding: 0.5rem 0.75rem;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--td-muted-foreground);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.15s, background-color 0.15s;
	}

	.nav-links a:hover {
		background-color: var(--td-muted);
		color: var(--td-ink);
	}

	.nav-links a[aria-current='page'] {
		color: var(--td-ink);
	}

	/* Extra links (Terms) only fit next to the Wiki / Docs switch on wide screens; they are in the Wiki sidebar anyway. */
	.nav-links .extra {
		display: none;
	}

	@media (min-width: 88rem) {
		.nav-links .extra {
			display: inline;
		}
	}

	/* Wiki / Docs switch: a pill group like the theme and language toggles, one step larger. */
	.topics {
		display: flex;
		gap: 0.125rem;
		margin-inline-end: 0.25rem;
		border-radius: 999px;
		background-color: var(--td-muted);
		padding: 0.1875rem;
	}

	.nav-links .topics a {
		padding: 0.3125rem 0.875rem;
		font-weight: 600;
	}

	.nav-links .topics a:hover {
		background-color: transparent;
	}

	.nav-links .topics a[aria-current='true'] {
		background-color: var(--td-background);
		color: var(--td-ink);
		box-shadow:
			0 1px 3px 0 oklch(0 0 0 / 0.1),
			0 1px 2px -1px oklch(0 0 0 / 0.1);
	}

	.right-group {
		gap: 0.5rem;
		align-items: center;
	}

	.social-icons {
		align-items: center;
		margin-inline: 0.25rem;
	}

	.social-icons :global(a) {
		color: var(--td-muted-foreground);
		padding: 0.375rem;
		border-radius: 999px;
		transition: color 0.15s, background-color 0.15s;
	}

	.social-icons :global(a:hover) {
		color: var(--td-ink);
		background-color: var(--td-muted);
		opacity: 1;
	}

	.support {
		display: none;
	}

	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.header {
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
						100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
					) / 2
			);
			display: grid;
			grid-template-columns:
				minmax(
					calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
					auto
				)
				1fr
				auto;
			align-content: center;
		}
	}

	@media (min-width: 72rem) {
		.nav-links,
		.support {
			display: flex;
		}
	}
</style>
